# ── Python ─────────────────────────────────────────────────────────
.venv*/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets — NEVER COMMIT ─────────────────────────────────────────
# Private + public keys, issued ledger:
keys/
*.pem
*.key
# Claude API key (per-user):
anthropic_api_key.txt
.env
.env.local

# ── User runtime data ──────────────────────────────────────────────
# Persistent Chromium user data:
browser_profile/
# Captured Recorder sessions:
recordings/
# SQLite jobs.db, jwt.json, templates.json, license.lic:
data/
logs/
# Downloaded mp4s:
output/

# ── Build artifacts ────────────────────────────────────────────────
# PyInstaller scratch:
build/
# PyInstaller --onedir output:
dist/
# Inno Setup output (.exe installers):
installer_output/
*.spec
# Keep the actual project specs (the spec files in repo root):
!RunwayAutomation.spec
!runway_app.spec
*.toc
*.log

# Generated by scripts/build_server.py — bakes RUNWAY_UI_MODE=web into bundle:
app/_build_mode.py

# Backup files (DB snapshots, configs) — created during deploys:
*.bak
*.bak-*

# ── Microsoft VC++ Redistributable ─────────────────────────────────
# Each developer downloads their own copy; not ours to redistribute.
redist/*.exe
redist/*.msi

# ── OS / IDE / tooling ─────────────────────────────────────────────
.DS_Store
# macOS resource forks left after rsync/scp to/from non-HFS volumes:
._*
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
.vscode/
.claude/
*.swp
*~
